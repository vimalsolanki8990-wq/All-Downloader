<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Category & Source Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_video"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/cat_video"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="[ VIDEO ]" />

            <TextView
                android:id="@+id/tvSourceType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:textColorTertiary"
                android:textSize="11sp"
                tools:text="OpenGraph Video (og:video)" />
        </LinearLayout>

        <!-- Main Media Info & Thumbnail Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_badge_image"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AllDown.Small"
                app:tint="@color/cat_image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="nature_4k_wallpaper_large.jpg" />

                <TextView
                    android:id="@+id/tvFileMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="12sp"
                    tools:text="JPG • 1920 × 1080 • 2.8 MB" />
            </LinearLayout>
        </LinearLayout>

        <!-- APK Security Notice (if applicable) -->
        <LinearLayout
            android:id="@+id/layoutApkWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_doc"
            android:backgroundTint="@color/color_warning_container"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/color_warning" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/apk_warning_msg"
                android:textColor="@color/text_primary_light"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Webpage Thumbnail / Restricted Stream Notice (if applicable) -->
        <LinearLayout
            android:id="@+id/layoutRestrictedNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_other"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_info"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvRestrictedNotice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Webpage thumbnail discovered (Video stream is protected/restricted)"
                android:textColor="?android:textColorPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Direct Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="@string/download"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
