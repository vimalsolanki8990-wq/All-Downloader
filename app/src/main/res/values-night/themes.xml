<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AllDownloader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/surface_variant_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.AllDown.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.AllDown.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.AllDown.Large</item>
    </style>

    <style name="Widget.AllDown.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
    </style>

    <style name="Widget.AllDown.OutlinedCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
    </style>
</resources>